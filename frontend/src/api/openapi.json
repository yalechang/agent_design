{
 "openapi": "3.1.0",
 "info": {
  "title": "Procurement Q&A Agent",
  "version": "1.0.0"
 },
 "paths": {
  "/health": {
   "get": {
    "summary": "Health",
    "operationId": "health_health_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HealthResponse"
        }
       }
      }
     }
    }
   }
  },
  "/fx/status": {
   "get": {
    "summary": "Fx Status",
    "operationId": "fx_status_fx_status_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/FxStatusResponse"
        }
       }
      }
     }
    }
   }
  },
  "/fx/refresh": {
   "post": {
    "summary": "Fx Refresh",
    "operationId": "fx_refresh_fx_refresh_post",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/FxStatusResponse"
        }
       }
      }
     }
    }
   }
  },
  "/summary": {
   "get": {
    "summary": "Summary",
    "description": "Deterministic overview; cached until the active ECB rate snapshots change.",
    "operationId": "summary_summary_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SummaryResponse"
        }
       }
      }
     }
    }
   }
  },
  "/ask": {
   "post": {
    "summary": "Ask",
    "description": "Every handled outcome (answered, no evidence, out of scope, LLM down...) is HTTP 200 with a status.\nHTTP 503 means the server is at its concurrency limit and nothing was attempted.",
    "operationId": "ask_ask_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/AskRequest"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AskResponse"
        }
       }
      }
     },
     "503": {
      "description": "Too many questions are being answered; retry shortly"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/traces/{trace_id}": {
   "get": {
    "summary": "Get Trace",
    "operationId": "get_trace_traces__trace_id__get",
    "parameters": [
     {
      "name": "trace_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Trace Id"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "additionalProperties": true,
         "title": "Response Get Trace Traces  Trace Id  Get"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  }
 },
